# Copy to .env and adjust. Every value below is a placeholder.
# The API needs no credentials — nothing here is a secret.

# Comma-separated browser origins allowed to call the API (CORS).
RISK_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# How many concurrent games the server keeps in memory before evicting the oldest.
RISK_MAX_SESSIONS=200

# Port uvicorn binds to. Used by the run command in the README, not read by the app.
RISK_API_PORT=8000
